<div class="mb-3 card" data-testid="referral-settings-card">
	<div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
		<h3 class="mb-0 card-title">{{ 'Referral program settings'|trans({}, 'referral.bo.default') }}</h3>
		<a class="btn btn-outline-secondary btn-sm" href="{{ referrals_url }}" data-testid="referral-list-link">{{ 'Referrals'|trans({}, 'referral.bo.default') }}</a>
	</div>
	<div class="card-body">
		{% form_theme form with bo_form_themes only %}
		{{ form_start(form, {'action': path('referral.bo.settings.save')}) }}
		{{ form_errors(form) }}
		{{ form_rest(form) }}
		{% if can_update %}
			<button type="submit" id="referral-settings-save" class="btn btn-primary">{{ 'Save'|trans({}, 'referral.bo.default') }}</button>
		{% endif %}
		{{ form_end(form) }}
	</div>
</div>
