{% extends "email-layout.html.twig" %}

{% block browser %}{% endblock %}
{% block image_header %}{% endblock %}
{% block pre_header %}{% endblock %}

{% set reward = reward_value_type == 'percent'
    ? format_number(reward_value, 0, null, null, locale) ~ ' %'
    : format_money(reward_value, currency_id, locale, null, null, null, true) %}

{% block email_subject %}{{ '%name% placed a first order: here is your reward'|trans({'%name%': referee_firstname}, 'referral.email.default', locale) }}{% endblock %}

{% block email_title %}{{ 'Thank you for your referral'|trans({}, 'referral.email.default', locale) }}{% endblock %}

{% block email_content %}
    {{ 'Hello,'|trans({}, 'referral.email.default', locale) }}<br /><br />
    {{ '%name%, whom you referred, has placed a first order. Thank you!'|trans({'%name%': referee_firstname}, 'referral.email.default', locale) }}<br /><br />
    {{ 'Your reward: %reward% off your next order, with the code below.'|trans({'%reward%': reward}, 'referral.email.default', locale) }}<br /><br />
    <strong style="font-size: 18px; letter-spacing: 1px;">{{ coupon_code }}</strong><br /><br />
    {% if minimum_amount > 0 %}
        {{ 'For an order of at least %amount%.'|trans({'%amount%': format_money(minimum_amount, currency_id, locale, null, null, null, true)}, 'referral.email.default', locale) }}<br />
    {% endif %}
    {% if expiration_date %}
        {{ 'Valid until %date%, for one use.'|trans({'%date%': format_date(expiration_date, 'date', null, locale)}, 'referral.email.default', locale) }}<br /><br />
    {% endif %}
    {{ 'Kind regards'|trans({}, 'referral.email.default', locale) }},<br />
    {{ 'The %store% team.'|trans({'%store%': config('store_name')}, 'referral.email.default', locale) }}
{% endblock %}
